# Environment Variables
# Do not commit the actual .env file to version control.

# --- Database ---
# URL format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://janconnect:secret@localhost:5432/janconnect?schema=public"

# --- Authentication ---
# Generate strong random strings for these in production (e.g. openssl rand -base64 32)
JWT_ACCESS_SECRET="dev-access-secret-key-change-in-prod"
JWT_REFRESH_SECRET="dev-refresh-secret-key-change-in-prod"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Backend ---
PORT=3000
NODE_ENV="development"

# --- Frontend ---
VITE_API_URL="http://localhost:3000/api/v1"
